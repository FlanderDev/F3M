# Copy to .env next to compose.yaml and fill in. .env is git-ignored; never commit real values.

# Required. Encrypts the catalog signing key in the storage volume. Back it up together with the key:
# without both, existing installs of the desktop app can no longer verify the catalog.
F3M_CATALOG_KEY_PASSWORD=

# Host port for the container's HTTP endpoint (default 62444).
F3M_HTTP_PORT=62444

# true when a reverse proxy terminates TLS in front of the container (default true).
F3M_BEHIND_PROXY=true

# The admin account. Created at the first start (or an existing account of that name is used) and made admin at
# every start. The password is only used when the account is created, so changing it on the site sticks.
F3M_ADMIN_USERNAME=
F3M_ADMIN_PASSWORD=

# true resets the admin's password to F3M_ADMIN_PASSWORD at every start, e.g. after it was lost. Turn it off again.
F3M_ADMIN_PASSWORD_OVERWRITE=false

# F95zone bot account for verifying account links. Optional: an admin can also enter it on the setup page
# (/admin/setup), which then replaces these.
F3M_F95BOT_BASE_URL=https://f95zone.to
F3M_F95BOT_USERNAME=
F3M_F95BOT_PASSWORD=
F3M_F95BOT_USER_ID=
