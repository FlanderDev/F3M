<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!--
      AspNetCoreVersion is resolved at build time from the installed SDK.
      This avoids hard-coding 9.x vs 10.x and prevents the MIME-type error
      caused by UseBlazorFrameworkFiles() not finding the WASM output.
    -->
		<AspNetCoreVersion>10.*-*</AspNetCoreVersion>
		<EFVersion>9.*-*</EFVersion>
		<!-- Local settings kept out of the repository, e.g. Catalog:KeyPassword for a signing key from a server backup. -->
		<UserSecretsId>26345dca-e32d-421a-9a9b-60cf1ba8b2fc</UserSecretsId>
	</PropertyGroup>
	<ItemGroup Condition="'$(F3MSourceCommit)' != ''">
		<!-- The git commit being built (the Dockerfile passes it); the admin page shows it as the running version. -->
		<AssemblyMetadata Include="SourceCommit" Value="$(F3MSourceCommit)" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="FlanderDev.RouteGen.Generators" Version="0.8.1">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
		<!-- Converts AVIF previews (F95zone serves its attachments as AVIF) to WebP, which the desktop app can read. -->
		<PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(AspNetCoreVersion)" />

		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(AspNetCoreVersion)" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
		<PackageReference Include="SharpCompress" Version="0.50.4" />
	</ItemGroup>

	<ItemGroup>
		<!-- The F95zone import plan; the server copies it to Storage/Import on first use. -->
		<Content Remove="Import\import-plan.json" />
		<EmbeddedResource Include="Import\import-plan.json" LogicalName="F3M.Server.Import.import-plan.json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\F3M.Shared\F3M.Shared.csproj" />
		<ProjectReference Include="..\F3M.Client\F3M.Client.csproj" />
	</ItemGroup>
</Project>
