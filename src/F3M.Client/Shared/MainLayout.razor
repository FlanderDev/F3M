@using F3M.Client.Components
@inherits LayoutComponentBase
@inject IAccountManagement Acct
@inject ITelemetryApi Telemetry
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable


<div class="f3m-wrapper">
    <nav class="navbar navbar-expand-lg navbar-dark f3m-navbar sticky-top">
        <div class="container-fluid px-2">
            <a class="navbar-brand d-flex align-items-center gap-2" href="@Paths.Index">
                <span class="f3m-logo-badge">F3M</span>
                <span class="f3m-brand-text d-none d-sm-inline">Mod Manager</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"
                    aria-controls="navMenu" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto gap-1">
                    <li class="nav-item">
                        <NavLink class="nav-link px-3 py-2 rounded" href="@Paths.Index" Match="NavLinkMatch.All">
                            <i class="bi bi-house me-1"></i>Home
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link px-3 py-2 rounded" href="@Paths.Upload">
                            <i class="bi bi-cloud-arrow-up me-1"></i>Upload
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link px-3 py-2 rounded" href="@Paths.TagBrowser">
                            <i class="bi bi-tags me-1"></i>Tags
                        </NavLink>
                    </li>
                </ul>
                <div class="container col f3m-nav-version">
                    <h4 class="my-0">@Configuration.HeaderDisclaimer</h4>
                </div>
                <ul class="navbar-nav gap-1 ms-auto">
                    <AuthorizeView>
                        <Authorized>
                            @if (context.User.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item">
                                    <NavLink class="nav-link px-3 py-2 rounded" href="@Paths.Admin">
                                        <i class="bi bi-shield-fill me-1 text-warning"></i>Admin
                                    </NavLink>
                                </li>
                            }
                            <li class="nav-item d-flex align-items-center">
                                <NavLink class="nav-link px-3 py-2" href="@Paths.Profile">
                                    <i class="bi bi-person-circle me-1 text-warning"></i>@context.User.Identity?.Name
                                </NavLink>
                            </li>
                            <li class="nav-item">
                                <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="LogoutAsync">
                                    <i class="bi bi-box-arrow-right me-1"></i>Sign Out
                                </button>
                            </li>
                        </Authorized>
                        <NotAuthorized>
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm fw-bold px-3 ms-1" href="@Paths.Login"><i class="bi bi-box-arrow-in-right me-1"></i>Sign in</a>
                            </li>
                        </NotAuthorized>
                    </AuthorizeView>
                </ul>
            </div>
        </div>
    </nav>

    <main class="f3m-main">@Body</main>

    <footer class="f3m-footer py-1">
        <div class="container text-center">
            <p class="mb-0 small">
                <strong class="text-warning">F</strong>landers
                <strong class="text-warning">M</strong>anaka
                <strong class="text-warning">M</strong>od
                <strong class="text-warning">M</strong>anager -
                <IconAnchor Href="https://f95zone.to/threads/secret-flasher-manaka-v1-1-3-sheablesoft.256682/" IconUrl="favicons/thirdParty/f95zoneLogo.png" Content="SFM Main Thread" />
                <IconAnchor Href="@Configuration.AdminContactUrl" IconUrl="favicons/thirdParty/f95zoneLogo.png" Content="FlanderDev" />
                <IconAnchor Href="https://discord.com/invite/eSWfUezM8K" IconUrl="favicons/thirdParty/discordLogo.png" Content="SFM Modding Community" />
                <IconAnchor Href="https://github.com/FlanderDev/F3M" IconUrl="favicons/thirdParty/github-white.png" Content="GitHub Repository" />
                <IconAnchor Href="@Configuration.DesktopDownloadUrl" IconUrl="favicons/thirdParty/github-white.png" Content="Desktop App" />
            </p>
        </div>
    </footer>
</div>

@code {
    // Blazor changes pages without loading one, so the menu opened on a small screen would stay open over the new page.
    // Also a good moment to pick up role changes.
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = Acct.RevalidateAsync();
        try
        {
            await JS.InvokeVoidAsync("f3m.closeNavMenu");
        }
        catch (JSException)
        {
            // An outdated f3m.js: the menu just stays open.
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // One page load (and the visitor, once a day) for the statistics page. The layout stays while the visitor moves
        // between pages, so this runs once per visit to the site.
        try
        {
            var visitorId = await JS.InvokeAsync<string?>("f3m.visitorId");
            await Telemetry.ReportVisit(new VisitReport { VisitorId = visitorId });
        }
        catch
        {
            // Only statistics.
        }
    }

    protected async Task LogoutAsync()
    {
        if (await Acct.CheckAuthenticatedAsync())
            await Acct.LogoutAsync();
    }
}
