<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreVersion>10.*-*</AspNetCoreVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.2.995" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(AspNetCoreVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="$(AspNetCoreVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(AspNetCoreVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="$(AspNetCoreVersion)" />

    <!-- Independent packages -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.*-*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required so RouteGen's page-route generator can see every @page directive and emit Paths. -->
    <AdditionalFiles Include="**/*.razor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\F3M.Shared\F3M.Shared.csproj" />
  </ItemGroup>
</Project>
