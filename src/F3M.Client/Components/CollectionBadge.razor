@implements IDisposable
@inject CollectionStore Store

@if (Store.Items.Count > 0)
{
    <a href="/collection/build" class="btn btn-outline-warning fw-bold px-4 me-2">
        <i class="bi bi-collection me-2"></i>My collection (@Store.Items.Count)
    </a>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        await Store.LoadAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Store.Changed -= OnChanged;
}
