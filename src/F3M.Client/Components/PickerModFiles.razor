@* Reusable mod-file list + add-file dropzone.
   Parent passes a List<FileEntry> via the Entries parameter.
   The component mutates that list in place and calls OnEntriesChanged
   so the parent can trigger StateHasChanged / validation as needed. *@

<div>
    <div class="d-flex justify-content-between align-items-center mb-2">
        <label class="form-label fw-semibold small mb-0">
            Mod Files <span class="text-danger">*</span>
            <span class="fw-normal"> — ZIP, RAR, 7Z, PAK, MOD (max 512 MB each)</span>
        </label>
        <span class="badge bg-secondary">
            @Entries.Count file@(Entries.Count != 1 ? "s" : string.Empty)
        </span>
    </div>

    @if (Entries.Count > 0)
    {
        <div class="d-flex flex-column gap-2 mb-2">
            @for (int i = 0; i < Entries.Count; i++)
            {
                var idx   = i;
                var entry = Entries[idx];
                <div class="f3m-file-entry">
                    <div class="f3m-file-entry-top">
                        <i class="bi bi-file-zip-fill text-warning fs-5 flex-shrink-0"></i>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-semibold small text-truncate">@entry.OriginalName</div>
                            <div style="font-size:.7rem;">@entry.Size.FileSize()</div>
                        </div>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger flex-shrink-0"
                                @onclick="() => Remove(idx)">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <div class="f3m-file-entry-path">
                        <i class="bi bi-tags flex-shrink-0" style="font-size:.8rem;" title="Type"></i>
                        <select class="f3m-type-select"
                                aria-label="Type of @entry.OriginalName"
                                value="@entry.Template"
                                @onchange="@(e => SetTemplate(entry, e.Value?.ToString()))">
                            @foreach (var template in ModTemplates.All)
                            {
                                <option value="@template.Id">@template.Name</option>
                            }
                        </select>
                        @if (entry.Suggestion is { TemplateId: not ModTemplates.Custom } suggestion)
                        {
                            <span class="f3m-type-hint">
                                @(suggestion.TemplateId == entry.Template ? "recognised from the contents" : $"looks like {TemplateName(suggestion.TemplateId)}")
                            </span>
                        }
                    </div>
                    <div class="f3m-file-entry-target">@(ModTemplates.Find(entry.Template)?.Description)</div>

                    @if (entry.Listing is not null)
                    {
                        <div class="f3m-file-entry-path">
                            <i class="bi bi-box-arrow-in-down-right flex-shrink-0" style="font-size:.8rem;" title="Archive folder"></i>
                            <input class="f3m-path-input"
                                   type="text"
                                   list="f3m-archive-folders-@idx"
                                   aria-label="Archive folder of @entry.OriginalName"
                                   placeholder="Folder inside the archive to install (empty: the whole archive)"
                                   value="@entry.ArchiveRoot"
                                   @onchange="@(e => SetArchiveRoot(entry, e.Value?.ToString()))" />
                            <datalist id="f3m-archive-folders-@idx">
                                @foreach (var folder in entry.ArchiveFolders)
                                {
                                    <option value="@folder"></option>
                                }
                            </datalist>
                        </div>
                    }

                    <div class="f3m-file-entry-path">
                        <i class="bi bi-folder2 flex-shrink-0" style="font-size:.8rem;" title="Install path"></i>
                        <input class="f3m-path-input"
                               type="text"
                               aria-label="Install path of @entry.OriginalName"
                               placeholder="Install path (e.g. BepInEx/plugins/MyMod)"
                               value="@entry.InstallPath"
                               @oninput="@(e => SetInstallPath(entry, e.Value?.ToString()))" />

                        <button type="button"
                                class="btn btn-sm btn-outline-warning flex-shrink-0"
                                @onclick="() => OpenFsd(idx)">
                            <i class="bi bi-folder2-open"></i>
                            @* SaveModFileDialog is mounted once outside the loop (see below)
                               to avoid one dialog DOM node per file row. *@
                        </button>
                    </div>

                    <div class="f3m-file-entry-target @(IsValidPath(entry) ? string.Empty : "text-danger")">
                        <i class="bi bi-arrow-return-right me-1"></i>@TargetHint(entry)
                    </div>
                    @foreach (var warning in entry.TypeWarnings)
                    {
                        <div class="f3m-file-entry-target text-warning">
                            <i class="bi bi-exclamation-triangle me-1"></i>@warning
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* One shared SaveModFileDialog, driven by _fsdTargetIndex *@
    <SaveModFileDialog @bind-Visible="_fsdOpen"
                       Title="Choose Install Path"
                       InitialPath="@(_fsdTargetIndex >= 0 && _fsdTargetIndex < Entries.Count ? Entries[_fsdTargetIndex].InstallPath : string.Empty)"
                       DefaultName="@(_fsdTargetIndex >= 0 && _fsdTargetIndex < Entries.Count ? Entries[_fsdTargetIndex].OriginalName : string.Empty)"
                       OnSave="ApplyFsdPath" />

    @* @key forces a fresh <input type=file> after each successful pick,
       preventing the _blazorFilesById crash on subsequent selections. *@
    <label @key="_addFileKey" class="f3m-dropzone f3m-dropzone-sm" style="cursor:pointer;">
        <i class="bi bi-plus-lg text-warning me-2"></i>
        <span class="small">
            @(Entries.Count == 0 ? "Choose file(s)" : "Add another file")
        </span>
        <InputFile OnChange="OnFileSelected"
                   accept=".zip,.rar,.7z,.pak,.mod"
                   style="display:none;"
                   multiple />
    </label>

    @if (Error is not null)
    {
        <p class="text-danger small mt-1">@Error</p>
    }

    <InstallPreview Entries="Entries" />
</div>
