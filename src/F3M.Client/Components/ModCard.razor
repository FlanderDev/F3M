@inject NavigationManager Nav

<div class="mod-card h-100" @onclick="NavigateToDetail">
    <div class="mod-card-image">
        @if (!string.IsNullOrEmpty(Mod.PreviewImageName))
        {
            <img src="@F3M.Shared.Helpers.Assets.ImageUrl(Mod.PreviewImageName)" alt="@Mod.Name preview" loading="lazy" />
        }
        else
        {
            <div class="mod-card-no-image"><i class="bi bi-box-seam"></i></div>
        }
        <TypeBadge TagIds="Mod.TagIds" />
    </div>
    <div class="mod-card-body">
        <h6 class="mod-card-title">@Mod.Name</h6>
        <p class="mod-card-author">
            by <a href="@Paths.PublicProfile(Mod.Author)" @onclick:stopPropagation="true">@Mod.Author</a>
        </p>
        <p class="mod-card-desc">@Mod.Description</p>
        <TagChips TagIds="Mod.TagIds" CommunityTagIds="Mod.CommunityTagIds" Limit="3" Class="mod-card-tags" />
        <div class="mod-card-meta">
            <span><i class="bi bi-download"></i> @Mod.DownloadCount.ToString("N0")</span>
            <span class="mod-card-version">v@(Mod.Version)</span>
            <DesktopDownloadButton GroupId="@Mod.ModGroupId" Compact="true" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Mod Mod { get; set; } = default!;
    private void NavigateToDetail() => Nav.NavigateTo(Paths.ModDetail(Mod.Id));
}
