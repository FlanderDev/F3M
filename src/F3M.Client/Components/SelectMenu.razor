@* A single-choice dropdown in the site's own menu style. A native <select> opens the browser's list, which pages
   can't style, so its colours and highlight don't match the rest of the site. *@
@typeparam TValue

<div class="dropdown f3m-select-menu">
    <button type="button" class="form-select f3m-select text-start text-truncate" data-bs-toggle="dropdown"
            aria-expanded="false" aria-label="@AriaLabel" disabled="@Disabled">
        @if (Placeholder is not null && !Items.Contains(Value))
        {
            <span class="f3m-select-placeholder">@Placeholder</span>
        }
        else
        {
            @TextOf(Value)
        }
    </button>
    <ul class="dropdown-menu f3m-dropdown-menu w-100">
        @foreach (var item in Items)
        {
            var selected = EqualityComparer<TValue>.Default.Equals(item, Value);
            <li>
                <button type="button" class="dropdown-item @(selected ? "active" : string.Empty)" aria-current="@(selected ? "true" : null)"
                        @onclick="() => SelectAsync(item)">
                    @TextOf(item)
                </button>
            </li>
        }
    </ul>
</div>

@code {
    [Parameter, EditorRequired] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter, EditorRequired] public IEnumerable<TValue> Items { get; set; } = [];

    /// <summary>The text shown for a value; its <c>ToString()</c> when not given.</summary>
    [Parameter] public Func<TValue, string>? Text { get; set; }

    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Shown while the value is none of the items.</summary>
    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private string TextOf(TValue value) => Text?.Invoke(value) ?? value?.ToString() ?? string.Empty;

    private async Task SelectAsync(TValue item)
    {
        if (EqualityComparer<TValue>.Default.Equals(item, Value))
            return;

        Value = item;
        await ValueChanged.InvokeAsync(item);
    }
}
