@using Markdig
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<div class="markdown-editor">
    <div class="toolbar">
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => WrapSelection("**", "**")'>Bold</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => WrapSelection("*", "*")'>Italic</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => WrapSelection("`", "`")'>Code</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="InsertHeading">H1</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="InsertBulletList">List</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="InsertLink">Link</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="InsertQuote">Quote</button>
    </div>

    <textarea class="form-control f3m-input markdown-input"
              rows="@MarkdownRows"
              @bind="Value"
              @bind:event="oninput"
              @onselect="StoreSelection"
              @onkeyup="StoreSelection"
              @onclick="StoreSelection"></textarea>
</div>

<div class="markdown-renderer">
    @((MarkupString)(Markdown.ToHtml(Value)))
</div>
