@* A mod's tags as small chips. Each one opens the browse page filtered by it. Tags whose suggestion reached the vote
   limit (community tags) come after the mod's own, with a dashed border. *@
@implements IDisposable
@inject TagDirectory Directory

@{
    var own = Directory.Resolve(TagIds).Where(t => IncludeTypes || !t.IsType).ToList();
    var chips = own.Select(t => (Tag: t, Community: false))
        .Concat(Directory.Resolve(CommunityTagIds).Where(t => own.All(o => o.Id != t.Id)).Select(t => (Tag: t, Community: true)))
        .ToList();
}
@if (chips.Count > 0)
{
    <div class="f3m-tags @Class">
        @foreach (var (tag, community) in chips.Take(Limit))
        {
            <a class="f3m-tag @(community ? "f3m-tag-community" : string.Empty)" href="@BrowseUrl(tag.Name)"
               title="@(community ? $"Suggested and voted for by visitors. {tag.Description}" : tag.Description ?? $"All mods tagged {tag.Name}")"
               @onclick:stopPropagation="true">@tag.Name</a>
        }
        @if (chips.Count > Limit)
        {
            <span class="f3m-tag f3m-tag-more" title="@string.Join(", ", chips.Skip(Limit).Select(c => c.Tag.Name))">+@(chips.Count - Limit)</span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyCollection<int> TagIds { get; set; } = [];

    /// <summary>Tags users suggested whose votes reached the limit (<see cref="Mod.CommunityTagIds"/>).</summary>
    [Parameter] public IReadOnlyCollection<int> CommunityTagIds { get; set; } = [];

    /// <summary>At most this many chips; the rest are counted in a "+n" chip.</summary>
    [Parameter] public int Limit { get; set; } = int.MaxValue;

    [Parameter] public string? Class { get; set; }

    /// <summary>Also show type tags; off where <see cref="TypeBadge"/> shows them.</summary>
    [Parameter] public bool IncludeTypes { get; set; }

    /// <summary>The browse page filtered by one tag.</summary>
    public static string BrowseUrl(string name) => $"{Paths.Index}?tags={Uri.EscapeDataString(name)}";

    protected override async Task OnInitializedAsync()
    {
        Directory.Changed += OnTagsChanged;
        await Directory.LoadAsync();
    }

    private void OnTagsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Directory.Changed -= OnTagsChanged;
}
