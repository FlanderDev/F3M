@* A mod's tags as small chips. Each one opens the browse page filtered by it. *@
@implements IDisposable
@inject TagDirectory Directory

@{
    var tags = Directory.Resolve(TagIds);
}
@if (tags.Count > 0)
{
    <div class="f3m-tags @Class">
        @foreach (var tag in tags.Take(Limit))
        {
            <a class="f3m-tag" href="@BrowseUrl(tag.Name)" title="@(tag.Description ?? $"All mods tagged {tag.Name}")"
               @onclick:stopPropagation="true">@tag.Name</a>
        }
        @if (tags.Count > Limit)
        {
            <span class="f3m-tag f3m-tag-more" title="@string.Join(", ", tags.Skip(Limit).Select(t => t.Name))">+@(tags.Count - Limit)</span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyCollection<int> TagIds { get; set; } = [];

    /// <summary>At most this many chips; the rest are counted in a "+n" chip.</summary>
    [Parameter] public int Limit { get; set; } = int.MaxValue;

    [Parameter] public string? Class { get; set; }

    /// <summary>The browse page filtered by one tag.</summary>
    public static string BrowseUrl(string name) => $"/?tags={Uri.EscapeDataString(name)}";

    protected override async Task OnInitializedAsync()
    {
        Directory.Changed += OnTagsChanged;
        await Directory.LoadAsync();
    }

    private void OnTagsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Directory.Changed -= OnTagsChanged;
}
