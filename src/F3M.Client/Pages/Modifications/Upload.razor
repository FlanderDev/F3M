@page "/Mod/upload"
@page "/Mod/upload/{GroupId:int}"
@using FlanderDev.RouteGen.Abstractions
@attribute [GeneratedPathName("/Mod/upload/{GroupId:int}", "UploadForGroup")]
@attribute [Authorize]
@inject IJSRuntime JS
@inject IModsApi ModsApi
@inject NavigationManager Nav
@inject TagDirectory TagList

<PageTitle>F3M - Upload</PageTitle>

<div class="container py-5">
    <div class="mb-4">
        <h1 class="fw-black mb-1 fs-2">@(IsNewVersion ? "Upload New Version" : "Upload a Mod")</h1>
        @if (IsNewVersion && existingMod is not null)
        {
            <p class="small mb-0">
                Adding a new version to <span class="text-warning fw-semibold">@existingMod.Name</span>
                &nbsp;·&nbsp; latest: <span>v@(existingMod.Version)</span>
            </p>
        }
        else
        {
            <p class="small mb-0">Share your creation with the community.</p>
        }
    </div>

    @if (uploadSuccess)
    {
        @if (uploadWarnings.Count > 0)
        {
            <div class="alert alert-warning py-2 small mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Published with notes:
                <ul class="mb-0 ps-3">
                    @foreach (var warning in uploadWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        <UploadSuccessBanner ModId="uploadedId"
                             IsNewVersion="IsNewVersion"
                             OnUploadAnother="Reset" />
    }
    else
    {
        <div class="f3m-surface rounded-3 p-4 border" style="border-color:var(--f3m-border);">
            <EditForm Model="dto" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <!-- Mod name -->
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Mod Name <span class="text-danger">*</span></label>
                    <InputText class="form-control f3m-input" placeholder="e.g. HD Texture Overhaul"
                               @bind-Value="dto.Name" disabled="@IsNewVersion" />
                    <ValidationMessage For="@(() => dto.Name)" class="text-danger small mt-1 d-block" />
                </div>

                <!-- Version + tags -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-4">
                        <label class="form-label fw-semibold small">Version <span class="text-danger">*</span></label>
                        <InputText class="form-control f3m-input" placeholder="1.0.0" @bind-Value="dto.Version" />
                        <ValidationMessage For="@(() => dto.Version)" class="text-danger small mt-1 d-block" />
                    </div>
                    <div class="col-12 col-sm-8">
                        <label class="form-label fw-semibold small">Tags</label>
                        @* The locked ones are the files' types; the others belong to the mod, and a new version keeps them
                           (they are changed on the edit page). *@
                        <TagPicker @bind-Selected="dto.TagIds" Max="TagRules.MaxTagsPerMod" Disabled="IsNewVersion"
                                   Offer="t => !t.IsType" Locked="TypeNames" LockedTitle="@TagHints.LockedType"
                                   Placeholder="Pick tags that describe the mod…" EmptyText="No matching tag. Missing one? Ask an admin." />
                        <div class="form-text small">
                            @if (IsNewVersion)
                            {
                                <text>A new version keeps the mod's tags. Change them on the mod's edit page.</text>
                            }
                            else
                            {
                                <text>Up to @TagRules.MaxTagsPerMod. <i class="bi bi-lock-fill"></i> The type comes from the files' types.</text>
                            }
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Description <span class="text-danger">*</span></label>
                    <ManualMarkdown @bind-Value="dto.Description" />
                    <ValidationMessage For="@(() => dto.Description)" class="text-danger small mt-1 d-block" />
                </div>

                <!-- Preview image -->
                <div class="mb-3">
                    <PickerImage HintText="@ImagePickerHint"
                                 @bind-ImageBytes="imageBytes"
                                 @bind-ImageFileName="imageFileName"
                                 @bind-PreviewDataUrl="previewDataUrl" />
                </div>

                <!-- Mod files -->
                <div class="mb-4">
                    <PickerModFiles Entries="fileEntries"
                                    ModName="@dto.Name"
                                    OnEntriesChanged="OnFilesChanged"
                                    OptionalGroups="optionalGroups"
                                    NormalizedGroups="OptionalCheck.Normalized"
                                    OnOptionalGroupsChanged="StateHasChanged" />
                </div>

                <!-- Optional files: examples, tutorials, readmes -->
                <div class="mb-4">
                    <OptionalGroupsEditor Groups="optionalGroups"
                                          ShippedPaths="ShippedPaths"
                                          Check="OptionalCheck"
                                          Dismissed="dismissedSuggestions"
                                          OnChanged="StateHasChanged" />
                </div>

                <!-- Generated files (plan 5.8) -->
                <div class="mb-4">
                    <GeneratedPathsEditor Entries="dto.GeneratedPaths"
                                          ShippedPaths="ShippedPaths"
                                          OnEntriesChanged="StateHasChanged" />
                </div>

                <!-- Mod Dependencies -->
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Mods which this mod depends on<span class="text-danger"></span></label>
                    <MultiSelectDropdown TModel="Mod"
                                         LoadValuesAsync="LoadMultiSelectDropdownValues"
                                         SelectedItems="dependencyItems"
                                         SelectedItemsChanged="OnDependenciesChanged" />
                </div>

                <!-- Upload error -->
                @if (uploadError is not null)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@uploadError
                    </div>
                }

                <!-- Progress bar -->
                @if (uploading)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>@UploadStatus</span>
                            <span class="fw-semibold">@UploadPercent%</span>
                        </div>
                        <div class="progress" style="height:8px;" role="progressbar" aria-label="Upload progress"
                             aria-valuenow="@UploadPercent" aria-valuemin="0" aria-valuemax="100">
                            <!-- Striped while nothing is moving: preparing the files, or the server checking them. -->
                            <div class="progress-bar bg-warning @(uploadTotal == 0 || uploadSent >= uploadTotal ? "progress-bar-striped progress-bar-animated" : string.Empty)"
                                 style="width:@(uploadTotal == 0 ? 100 : UploadPercent)%"></div>
                        </div>
                    </div>
                }

                @if (HasInvalidInstallPaths)
                {
                    <div class="alert alert-warning py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Fix the install paths marked in red before publishing.
                    </div>
                }

                @if (TypeWarnings is { Count: > 0 } typeWarnings)
                {
                    <div class="alert alert-warning py-2 small mb-3">
                        <div class="fw-semibold mb-1">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Please check before publishing
                        </div>
                        <ul class="mb-2 ps-3">
                            @foreach (var warning in typeWarnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="accept-type-warnings"
                                   checked="@WarningsAccepted"
                                   @onchange="@(e => WarningsAccepted = e.Value is true)" />
                            <label class="form-check-label" for="accept-type-warnings">
                                I've checked these and want to publish anyway.
                            </label>
                        </div>
                    </div>
                }

                @if (HasInvalidOptionalGroups)
                {
                    <div class="alert alert-warning py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Fix the optional files before publishing: @OptionalCheck.Error
                    </div>
                }

                @if (HasInvalidGeneratedPaths)
                {
                    <div class="alert alert-warning py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Fix the generated-file patterns marked in red before publishing.
                    </div>
                }

                <!-- Submit -->
                <button type="submit" class="btn btn-warning fw-bold w-100"
                        disabled="@(uploading || fileEntries.Count == 0 || HasInvalidInstallPaths || HasInvalidGeneratedPaths || HasInvalidOptionalGroups || NeedsConfirmation)">
                    @if (uploading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Uploading @fileEntries.Count file@(fileEntries.Count != 1 ? "s" : string.Empty)…</span>
                    }
                    else
                    {
                        <i class="bi bi-cloud-arrow-up-fill me-2"></i>
                        <span>@(IsNewVersion ? "Publish New Version" : "Upload Mod")</span>
                    }
                </button>
            </EditForm>
        </div>
    }
</div>
