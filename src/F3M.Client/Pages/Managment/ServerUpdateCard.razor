@* The admin page's "Server update" card: the running version, new commits waiting on the branch, and a button that
   asks the host to update (backup, newest code, rebuild, restart). The host does the work; see admin-updates.sh. *@
@implements IDisposable
@inject IServerUpdateApi Api
@inject NavigationManager Navigation

<div class="f3m-surface rounded-3 border p-4 mb-4" style="border-color:var(--f3m-border);">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div style="max-width:620px;">
            <h2 class="fs-5 fw-bold mb-2">
                <i class="bi bi-cloud-arrow-up-fill text-warning me-2"></i>Server update
            </h2>
            <p class="small mb-1">
                Running version:
                <strong>@(status?.RunningCommit is { } runningCommit ? Short(runningCommit) : "unknown")</strong>
                @if (status?.Branch is { } branch)
                {
                    <span class="f3m-chart-muted">@($" on {branch}")</span>
                }
                @if (status?.RunningVersion is { } built)
                {
                    <span class="f3m-chart-muted">@($" · built {built}")</span>
                }
            </p>
            @if (status is { HelperInstalled: true, CheckedAt: { } checkedAt })
            {
                <p class="small f3m-chart-muted mb-0">Last looked for updates @Ago(checkedAt).</p>
            }
        </div>

        @if (status is { HelperInstalled: true } && !Busy)
        {
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary fw-semibold" @onclick="CheckNow" disabled="@(status.CheckRequested || requesting)">
                    @if (status.CheckRequested)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span><span>Checking…</span>
                    }
                    else
                    {
                        <span><i class="bi bi-arrow-clockwise me-1"></i>Check now</span>
                    }
                </button>
                @if (status.NewCommits.Count > 0 && !confirming)
                {
                    <button class="btn btn-warning fw-semibold" @onclick="() => confirming = true" disabled="@requesting">
                        <i class="bi bi-cloud-arrow-up me-1"></i>Update now
                    </button>
                }
            </div>
        }
    </div>

    @if (error is not null)
    {
        <div class="alert alert-danger small mt-3 mb-0">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
        </div>
    }

    @if (status is null)
    {
        @if (loading)
        {
            <div class="placeholder-glow mt-3"><span class="placeholder col-6"></span></div>
        }
    }
    else if (restarting)
    {
        <div class="alert alert-info small mt-3 mb-0 d-flex align-items-center gap-2">
            <span class="spinner-border spinner-border-sm"></span>
            The server is restarting with the new version. This page reconnects by itself.
        </div>
    }
    else if (!status.HelperInstalled)
    {
        <div class="alert alert-secondary small mt-3 mb-0">
            <div class="fw-semibold mb-1"><i class="bi bi-info-circle me-1"></i>Not set up on this server</div>
            Updating from here needs a small service on the server, which runs the update there. To install it, run this
            in the F3M folder on the server:
            <pre class="f3m-update-command mt-2 mb-0">./admin-updates.sh</pre>
        </div>
    }
    else
    {
        @if (confirming)
        {
            <div class="alert alert-warning small mt-3 mb-0">
                <div class="fw-semibold mb-1">Update the server now?</div>
                A backup is made first. Then the newest code is built and the server restarts: the site is unavailable for
                about a minute, and visitors may need to reload. If the new version doesn't start, the log below says how to
                go back.
                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-sm btn-warning fw-bold" @onclick="UpdateNow" disabled="@requesting">
                        @if (requesting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Yes, update
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirming = false">Cancel</button>
                </div>
            </div>
        }

        @if (status.UpdateRequested)
        {
            <div class="alert alert-info small mt-3 mb-0 d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm"></span>
                Update requested. Waiting for the server to start it…
            </div>
        }
        else if (status.State == ServerUpdateState.Running)
        {
            <div class="alert alert-info small mt-3 mb-0 d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm"></span>
                Updating since @status.StartedAt?.ToLocalTime().ToString("HH:mm"): backup, new code, rebuild. The server restarts at the end.
            </div>
        }
        else if (updatedTo is not null)
        {
            <div class="alert alert-success small mt-3 mb-0">
                <i class="bi bi-check-circle-fill me-2"></i>The server now runs @Short(updatedTo).
                This page still runs the old version.
                <button class="btn btn-sm btn-outline-success ms-2" @onclick="Reload">Reload page</button>
            </div>
        }
        else if (status.State == ServerUpdateState.Succeeded && status.FinishedAt is { } finished)
        {
            <p class="small f3m-chart-muted mt-3 mb-0">
                <i class="bi bi-check-circle me-1"></i>The last update finished @finished.ToLocalTime().ToString("MMM d, HH:mm").
            </p>
        }
        else if (status.State == ServerUpdateState.Failed)
        {
            <div class="alert alert-danger small mt-3 mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>The last update failed
                (@status.FinishedAt?.ToLocalTime().ToString("MMM d, HH:mm"), exit code @status.ExitCode). The log below says why.
            </div>
        }

        @if (status.CheckError is { } checkError)
        {
            <div class="alert alert-warning small mt-3 mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Looking for updates failed: @checkError
            </div>
        }

        @if (status.RunningCommit is { } running && status.HeadCommit is { } head && !SameCommit(running, head) && !Busy)
        {
            <div class="alert alert-warning small mt-3 mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>The F3M folder on the server has the code of @Short(head), but the running
                server was built from @Short(running): it wasn't rebuilt since, or the rebuild failed. Updating rebuilds it.
            </div>
        }

        @if (status.NewCommits.Count == 0 && status.CheckError is null && !Busy)
        {
            <p class="small mt-3 mb-0"><i class="bi bi-check-circle text-success me-1"></i>Up to date: nothing new on @(status.Upstream ?? "the branch").</p>
        }
        else if (status.NewCommits.Count > 0)
        {
            <div class="small fw-semibold mt-3 mb-1">@status.NewCommits.Count new @(status.NewCommits.Count == 1 ? "commit" : "commits") on @status.Upstream</div>
            <ul class="list-unstyled small mb-0 f3m-update-commits">
                @foreach (var commit in status.NewCommits.Take(15))
                {
                    <li class="d-flex gap-2">
                        <code>@Short(commit.Sha)</code>
                        <span class="flex-grow-1 text-break">@commit.Subject</span>
                        @if (commit.Date is { } date)
                        {
                            <span class="f3m-chart-muted text-nowrap">@date.LocalDateTime.ToString("MMM d")</span>
                        }
                    </li>
                }
            </ul>
            @if (status.NewCommits.Count > 15)
            {
                <div class="small f3m-chart-muted">and @(status.NewCommits.Count - 15) more</div>
            }
        }

        @if (!string.IsNullOrEmpty(status.Log))
        {
            <details class="mt-3" open="@(status.State is ServerUpdateState.Running or ServerUpdateState.Failed)">
                <summary class="small fw-semibold">Log of the last update</summary>
                <pre class="f3m-update-log mt-2 mb-0">@status.Log</pre>
            </details>
        }
    }
</div>
