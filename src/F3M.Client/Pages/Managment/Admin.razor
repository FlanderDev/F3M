@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = AppRoles.Admin)]

<PageTitle>F3M - Admin</PageTitle>

@* The admin area's start page: every admin page with what it is for. The sidebar links the same pages. *@
<div style="max-width:1000px;">
    <div class="mb-4">
        <h1 class="fw-black mb-1 fs-2">
            <i class="bi bi-shield-fill text-warning me-2"></i>Admin Panel
        </h1>
        <p class="small mb-0">Manage the site, its users and its mods. Every page is also in the sidebar.</p>
    </div>

    @foreach (var group in AdminSections.All.GroupBy(s => s.Group))
    {
        <h2 class="f3m-admin-nav-group mb-2">@group.Key</h2>
        <div class="row g-3 mb-4">
            @foreach (var section in group)
            {
                <div class="col-sm-6 col-xl-4">
                    <a class="f3m-admin-tile" href="@section.Href">
                        <span class="f3m-admin-tile-title">
                            <i class="bi @section.Icon text-warning"></i>@section.Title
                        </span>
                        <span class="small">@section.Summary</span>
                    </a>
                </div>
            }
        </div>
    }
</div>
