@page "/admin"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAdminApi Api

<PageTitle>F3M - Admin</PageTitle>

<div class="container py-5" style="max-width:900px;">
    <div class="mb-4">
        <h1 class="fw-black mb-1 fs-2">
            <i class="bi bi-shield-fill text-warning me-2"></i>Admin Panel
        </h1>
        <p class="small mb-0">Manage users, permissions and the mod catalog.</p>
    </div>

    <!-- Statistics -->
    <div class="f3m-surface rounded-3 border p-4 mb-4" style="border-color:var(--f3m-border);">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div style="max-width:620px;">
                <h2 class="fs-5 fw-bold mb-2">
                    <i class="bi bi-graph-up text-warning me-2"></i>Statistics
                </h2>
                <p class="small mb-0">
                    Downloads, visitors, searches, accounts, uploads and problems over time, with charts.
                </p>
            </div>
            <a class="btn btn-outline-warning fw-semibold" href="/admin/stats">
                <i class="bi bi-arrow-right me-1"></i>Open statistics
            </a>
        </div>
    </div>

    <!-- Site setup -->
    <div class="f3m-surface rounded-3 border p-4 mb-4" style="border-color:var(--f3m-border);">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div style="max-width:620px;">
                <h2 class="fs-5 fw-bold mb-2">
                    <i class="bi bi-ui-checks text-warning me-2"></i>Site setup
                </h2>
                <p class="small mb-0">
                    A checklist of what a new site still needs, the F95zone bot account for account linking, and the
                    import of the frameworks.
                </p>
            </div>
            <a class="btn btn-outline-warning fw-semibold" href="/admin/setup">
                <i class="bi bi-arrow-right me-1"></i>Open setup
            </a>
        </div>
    </div>

    <!-- F95zone import -->
    <div class="f3m-surface rounded-3 border p-4 mb-4" style="border-color:var(--f3m-border);">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div style="max-width:620px;">
                <h2 class="fs-5 fw-bold mb-2">
                    <i class="bi bi-cloud-download-fill text-warning me-2"></i>F95zone import
                </h2>
                <p class="small mb-0">
                    Downloads the community mods from F95zone and imports them as unclaimed mods for their uploaders,
                    step by step, with progress and problems.
                </p>
            </div>
            <a class="btn btn-outline-warning fw-semibold" href="/admin/import">
                <i class="bi bi-arrow-right me-1"></i>Open import
            </a>
        </div>
    </div>

    <!-- Catalog maintenance -->
    <div class="f3m-surface rounded-3 border p-4 mb-4" style="border-color:var(--f3m-border);">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
            <div style="max-width:620px;">
                <h2 class="fs-5 fw-bold mb-2">
                    <i class="bi bi-journal-check text-warning me-2"></i>Mod catalog
                </h2>
                <p class="small mb-2">
                    The catalog is the signed list of approved mods that the desktop app and shared collections read.
                    It updates on its own whenever a mod is uploaded, edited or deleted.
                </p>
                <p class="small mb-1">Rebuild it by hand when:</p>
                <ul class="small mb-2">
                    <li>a new server version was deployed, or a backup was restored;</li>
                    <li>mods were changed directly in the database;</li>
                    <li>the desktop app is missing mods, or cannot verify the catalog;</li>
                    <li>the server log says <em>"Run the catalog rebuild to repair it"</em>.</li>
                </ul>
                <p class="small mb-0">
                    A rebuild re-signs every approved version, removes entries for versions that no longer exist,
                    and fills in file details for mods uploaded before the catalog existed.
                    It is safe to run at any time, and the site stays online while it runs.
                </p>
            </div>
            <button class="btn btn-warning fw-semibold" @onclick="RebuildCatalog" disabled="@rebuilding">
                @if (rebuilding)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span><span>Rebuilding…</span>
                }
                else
                {
                    <span><i class="bi bi-arrow-repeat me-1"></i>Rebuild catalog</span>
                }
            </button>
        </div>

        @if (rebuildError is not null)
        {
            <div class="alert alert-danger small mt-3 mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@rebuildError
            </div>
        }
        else if (rebuildResult is not null)
        {
            <div class="alert @(rebuildResult.Errors.Count > 0 ? "alert-warning" : "alert-success") small mt-3 mb-0">
                <div>
                    <i class="bi @(rebuildResult.Errors.Count > 0 ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
                    Catalog rebuilt: @rebuildResult.VersionsPublished version@(rebuildResult.VersionsPublished != 1 ? "s" : string.Empty) published,
                    @rebuildResult.VersionsRemoved outdated entr@(rebuildResult.VersionsRemoved != 1 ? "ies" : "y") removed,
                    @rebuildResult.FilesBackfilled file@(rebuildResult.FilesBackfilled != 1 ? "s" : string.Empty) updated.
                </div>
                @if (rebuildResult.Errors.Count > 0)
                {
                    <p class="mt-2 mb-1">
                        These versions were left out because their files could not be read.
                        Re-upload or delete them, then rebuild again:
                    </p>
                    <ul class="mb-0">
                        @foreach (var error in rebuildResult.Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                }
            </div>
        }
    </div>

    @if (loading)
    {
        <div class="placeholder-glow">
            @for (int i = 0; i < 5; i++)
            {
                <div class="placeholder w-100 mb-2" style="height:48px;border-radius:8px;"></div>
            }
        </div>
    }
    else if (loadError is not null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@loadError
        </div>
    }
    else
    {
        <!-- Search -->
        <div class="input-group mb-4" style="max-width:360px;">
            <span class="input-group-text f3m-search-icon"><i class="bi bi-search"></i></span>
            <input class="form-control f3m-search-input" type="search"
                   placeholder="Search users…"
                   @bind="search" @bind:event="oninput" />
        </div>

        <div class="f3m-surface rounded-3 border overflow-hidden" style="border-color:var(--f3m-border);">
            <table class="table table-dark table-hover mb-0 f3m-admin-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>F95zone</th>
                        <th class="text-center">Mods</th>
                        <th>Registered</th>
                        <th class="text-center">Role</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Filtered)
                    {
                        var u = user;
                        <tr class="@(u.IsAdmin ? "f3m-admin-row" : string.Empty)">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="f3m-user-avatar @(u.IsAdmin ? "admin" : string.Empty)">
                                        @u.Username[0].ToString().ToUpper()
                                    </span>
                                    <a href="@Paths.PublicProfile(u.Username)" class="fw-semibold small text-decoration-none">@u.Username</a>
                                </div>
                            </td>
                            <td class="small align-middle">
                                @if (u.F95UserId is { } f95UserId)
                                {
                                    <a href="@F95Profile.LinkFor(u.F95Username, f95UserId)" target="_blank" rel="noopener noreferrer"
                                       class="btn btn-sm btn-outline-warning text-nowrap" title="Open @(u.F95Username ?? u.Username)'s F95zone profile in a new tab">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>@(u.F95Username ?? "Profile")
                                    </a>
                                }
                                else
                                {
                                    <span class="fst-italic" style="color:var(--f3m-muted)">Not linked</span>
                                }
                            </td>
                            <td class="text-center align-middle">
                                <span class="badge bg-secondary">@u.ModCount</span>
                            </td>
                            <td class="small align-middle">
                                @u.RegisteredAt.ToString("MMM d, yyyy")
                            </td>
                            <td class="text-center align-middle">
                                @if (u.IsAdmin)
                                {
                                    <span class="badge f3m-badge-admin">
                                        <i class="bi bi-shield-fill me-1"></i>Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">User</span>
                                }
                            </td>
                            <td class="text-end align-middle">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm @(u.IsAdmin ? "btn-outline-warning" : "btn-outline-secondary") fw-semibold"
                                            @onclick="() => ToggleAdmin(u)"
                                            disabled="@(busyId == u.Id)">
                                        @if (busyId == u.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else if (u.IsAdmin)
                                        {
                                            <span><i class="bi bi-shield-minus me-1"></i>Revoke</span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-shield-plus me-1"></i>Make Admin</span>
                                        }
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            title="Delete user"
                                            @onclick="() => ConfirmDelete(u)"
                                            disabled="@(busyId == u.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Filtered.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 small">No users match your search.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="small mt-3">@users.Count total user@(users.Count != 1 ? "s" : string.Empty)</p>
    }

    <!-- The site log: what the server did and what went wrong, on the server and in visitors' browsers -->
    <div class="f3m-surface rounded-3 border p-4 mt-4" style="border-color:var(--f3m-border);">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <h2 class="fs-5 fw-bold mb-0">
                <i class="bi bi-journal-text text-warning me-2"></i>Log
                @if (logTotal > 0)
                {
                    <span class="badge bg-secondary ms-1 align-middle">@logTotal</span>
                }
            </h2>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ReloadLog" disabled="@loadingLog">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
        <p class="small mb-3">
            Sign-ins, uploads, edits, deletions and admin actions, plus warnings and errors from the server and from visitors'
            browsers. Newest first; entries older than @IAdminApi.LogRetentionDays days are removed.
        </p>

        <div class="d-flex flex-wrap gap-2 mb-3">
            <select class="form-select form-select-sm f3m-input f3m-log-filter" aria-label="Lowest level shown"
                    @bind:get="logMinLevel" @bind:set="OnLogMinLevelChanged">
                <option value="@LogSeverity.Information">Info and above</option>
                <option value="@LogSeverity.Warning">Warnings and errors</option>
                <option value="@LogSeverity.Error">Errors only</option>
            </select>
            <select class="form-select form-select-sm f3m-input f3m-log-filter" aria-label="Source"
                    @bind:get="logSource" @bind:set="OnLogSourceChanged">
                <option value="@LogSourceFilter.All">Server and browsers</option>
                <option value="@LogSourceFilter.Server">Server only</option>
                <option value="@LogSourceFilter.Browser">Browsers only</option>
            </select>
            <div class="input-group input-group-sm f3m-log-search">
                <input type="search" class="form-control f3m-input" placeholder="Search message, user or source"
                       @bind="logSearch" @bind:event="oninput" @onkeydown="OnLogSearchKeyDown" />
                <button class="btn btn-outline-secondary" @onclick="ReloadLog" disabled="@loadingLog" aria-label="Search">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </div>

        @if (logError is not null)
        {
            <div class="alert alert-danger small mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>@logError</div>
        }

        @if (logEntries.Count == 0 && !loadingLog && logError is null)
        {
            <div class="small f3m-import-muted">No entries match.</div>
        }

        @foreach (var entry in logEntries)
        {
            <details class="f3m-error-report">
                <summary>
                    <span class="f3m-error-time">@entry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                    <span class="badge @LevelBadge(entry.Level) f3m-log-level">@LevelName(entry.Level)</span>
                    @if (entry.Source == LogSource.Browser)
                    {
                        <i class="bi bi-window f3m-import-muted" title="Reported by a visitor's browser"></i>
                    }
                    <span class="f3m-error-message">@entry.Message</span>
                </summary>
                <div class="small mt-2">
                    @if (!string.IsNullOrWhiteSpace(entry.Category))
                    {
                        <div class="text-break">
                            <span class="f3m-import-muted">@(entry.Source == LogSource.Browser ? "Source:" : "From:")</span>
                            <span title="@entry.Category">@(entry.Source == LogSource.Server ? ShortCategory(entry.Category) : entry.Category)</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.UserName))
                    {
                        <div><span class="f3m-import-muted">User:</span> <a href="@($"profile/{Uri.EscapeDataString(entry.UserName)}")">@entry.UserName</a></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.RequestPath))
                    {
                        <div class="text-break"><span class="f3m-import-muted">@(entry.Source == LogSource.Browser ? "Page:" : "Request:")</span> @entry.RequestPath</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.Details))
                    {
                        <pre class="f3m-error-stack">@entry.Details</pre>
                    }
                </div>
            </details>
        }

        @if (loadingLog)
        {
            <div class="small f3m-import-muted mt-2"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</div>
        }
        else if (logEntries.Count < logTotal)
        {
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                <span class="small f3m-import-muted">Showing @logEntries.Count of @logTotal.</span>
                <button class="btn btn-sm btn-outline-warning" @onclick="LoadMoreLog">Load @Math.Min(LogPageSize, logTotal - logEntries.Count) more</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAllLog">Load all</button>
            </div>
        }
    </div>
</div>

<!-- Delete confirm modal (CSS-only, no JS modal needed) -->
@if (deleteTarget is not null)
{
    <div class="f3m-modal-backdrop" @onclick="() => deleteTarget = null">
        <div class="f3m-modal" @onclick:stopPropagation="true">
            <h5 class="fw-black mb-2">Delete user?</h5>
            <p class="small mb-1">
                This will permanently delete <strong>@deleteTarget.Username</strong>'s account.
                Their mods stay on the site, unclaimed: they go to their F95zone uploader on that user's next sign-in, or you assign them on the mod page.
            </p>
            @if (actionError is not null)
            {
                <p class="text-danger small mb-2">@actionError</p>
            }
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-danger fw-bold flex-grow-1"
                        @onclick="ExecuteDelete"
                        disabled="@(busyId == deleteTarget.Id)">
                    @if (busyId == deleteTarget.Id)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Delete
                </button>
                <button class="btn btn-outline-secondary" @onclick="() => deleteTarget = null">Cancel</button>
            </div>
        </div>
    </div>
}


