@page "/"
@page "/Browse"
@using FlanderDev.RouteGen.Abstractions
@attribute [GeneratedPathName("/Browse", "Browse")]

@inject IModsApi ModsApi
@inject ITelemetryApi Telemetry
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>F3M - Browse</PageTitle>

<!-- Header bar -->
<div class="f3m-page-header">
    <div class="container-fluid px-4 py-4">
        <div class="row align-items-center g-3">
            <div class="col">
                <h1 class="fw-black mb-0 fs-3">Browse Mods</h1>
                <p class="small mb-0">@totalCount mods available</p>
            </div>
            <div class="col-auto">
                <CollectionBadge />
                <AuthorizeView>
                    <Authorized>
                        <a href="@Paths.Upload" class="btn btn-warning fw-bold px-4">
                            <i class="bi bi-cloud-arrow-up me-2"></i>Upload Mod
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="@Paths.Login" class="btn btn-outline-warning fw-bold px-4">
                            <i class="bi bi-cloud-arrow-up me-2"></i>Upload Mod
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <!-- Filters -->
        <div class="row g-2 mt-3">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text f3m-search-icon">
                        <i class="bi bi-search"></i>
                    </span>
                    <input class="form-control f3m-search-input"
                           type="search"
                           placeholder="Search mods, authors…"
                           @bind="searchTerm"
                           @bind:event="oninput"
                           @onkeyup="OnSearchKeyUp" />
                </div>
            </div>
            @* The two menus share the row with the clear button at every width, so it never wraps onto a row of its own. *@
            <div class="col col-md-3">
                <SelectMenu TValue="string" @bind-Value="selectedCategory" @bind-Value:after="LoadMods"
                            Items="CategoryOptions" AriaLabel="Category" />
            </div>
            <div class="col col-md-3">
                <SelectMenu TValue="SortBy" @bind-Value="sortBy" @bind-Value:after="LoadMods"
                            Items="Enum.GetValues<SortBy>()" Text="SortText" AriaLabel="Sort by" />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary" @onclick="ClearFilters" title="Clear filters" aria-label="Clear filters">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <!-- Category chips -->
        @if (categories.Any())
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button class="f3m-chip @(selectedCategory == CategoryAll ? "active" : string.Empty)"
                        @onclick='() => SelectCategory(CategoryAll)'>
                    All
                </button>
                @foreach (var cat in categories)
                {
                    <button class="f3m-chip @(selectedCategory == cat ? "active" : string.Empty)"
                            @onclick="() => SelectCategory(cat)">
                        @cat
                    </button>
                }
            </div>
        }
    </div>
</div>

<!-- Mod grid -->
<div class="container-fluid px-4 py-4">
    @if (loading)
    {
        @* The placeholders also tell how many cards fit on the screen (see OnAfterRenderAsync). *@
        <div class="mod-grid" @ref="placeholderGrid">
            @for (int i = 0; i < 12; i++)
            {
                <div class="mod-card-skeleton">
                    <div class="skeleton-img"></div>
                    <div class="skeleton-body">
                        <div class="skeleton-line w-75"></div>
                        <div class="skeleton-line w-50 mt-1"></div>
                        <div class="skeleton-line w-full mt-2"></div>
                        <div class="skeleton-line w-90"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (mods.Count == 0)
    {
        <div class="f3m-empty text-center py-5">
            <i class="bi bi-inbox display-3 opacity-50 d-block mb-3"></i>
            <h5 class="fw-bold mb-1">No mods found</h5>
            <p class="small">Try adjusting your filters.</p>
            <button class="btn btn-sm btn-outline-warning mt-2" @onclick="ClearFilters">Clear Filters</button>
        </div>
    }
    else
    {
        <div class="mod-grid">
            @foreach (var mod in mods)
            {
                <ModCard @key="mod.Id" Mod="mod" />
            }
        </div>

        @if (loadingMore)
        {
            <div class="text-center py-4">
                <span class="spinner-border spinner-border-sm text-warning me-2"></span>
                <span class="small">Loading more mods…</span>
            </div>
        }
        else if (mods.Count < totalCount)
        {
            @* Usually the list grows before this is reached; for keyboards, and when scrolling can't be watched. *@
            <div class="text-center py-4">
                <button class="btn btn-sm btn-outline-warning" @onclick="LoadMoreClicked">
                    Load more (@(totalCount - mods.Count) left)
                </button>
            </div>
        }
        else if (totalCount > batchSize)
        {
            <p class="text-center small py-4 mb-0">That's all @totalCount mods.</p>
        }
    }

    <div @ref="listEnd" aria-hidden="true"></div>
</div>
