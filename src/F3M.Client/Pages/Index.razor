@page "/"
@page "/Browse"
@using FlanderDev.RouteGen.Abstractions
@attribute [GeneratedPathName("/Browse", "Browse")]

@inject IModsApi ModsApi
@inject ITelemetryApi Telemetry
@inject IJSRuntime JS
@inject TagDirectory Tags
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>F3M - Browse</PageTitle>

<!-- Header and filters -->
<section class="f3m-browse-head">
    <div class="container-fluid px-4 pt-4 pb-4">
        <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
            <div class="me-auto">
                <h1 class="f3m-browse-title">Browse mods</h1>
                <p class="f3m-browse-count mb-0" aria-live="polite">
                    @if (loading && mods.Count == 0)
                    {
                        <span>Loading mods…</span>
                    }
                    else
                    {
                        <strong>@totalCount</strong>@CountText
                    }
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <CollectionBadge />
                <AuthorizeView>
                    <Authorized>
                        <a href="@Paths.Upload" class="btn btn-warning fw-bold px-4">
                            <i class="bi bi-cloud-arrow-up me-2"></i>Upload mod
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="@Paths.Login" class="btn btn-outline-warning fw-bold px-4">
                            <i class="bi bi-cloud-arrow-up me-2"></i>Upload mod
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <div class="f3m-filter-panel">
            <div class="f3m-filter-main">
                <div class="f3m-filter-field f3m-filter-search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" placeholder="Search mods and authors…" aria-label="Search mods and authors" autocomplete="off"
                           @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                    @if (searchTerm.Length > 0)
                    {
                        <button type="button" class="f3m-filter-clear" @onclick="ClearSearch" aria-label="Clear the search" title="Clear the search">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>
                @if (Tags.Tags.Count > 0)
                {
                    @* A mod must have every picked tag (or a tag it includes). *@
                    <div class="f3m-filter-field f3m-filter-tags">
                        <i class="bi bi-tags" aria-hidden="true"></i>
                        <TagPicker Selected="Tags.Ordinary(selectedTags)" SelectedChanged="OnOrdinaryTagsPicked" ShowCounts="true"
                                   Offer="t => !t.IsType" Placeholder="Filter by tags…" AriaLabel="Filter by tags" />
                    </div>
                }
                <div class="f3m-filter-field f3m-filter-sort">
                    <i class="bi bi-sort-down" aria-hidden="true"></i>
                    <SelectMenu TValue="SortBy" @bind-Value="sortBy" @bind-Value:after="LoadMods"
                                Items="Enum.GetValues<SortBy>()" Text="SortText" AriaLabel="Sort by" />
                </div>
            </div>

            <!-- Type pills: one click for the type tags, together with the tags picked above -->
            @if (Tags.TypeTags is { Count: > 0 } types)
            {
                var anyType = selectedTags.Any(Tags.IsType);
                <div class="f3m-filter-types">
                    <div class="f3m-type-pills" role="group" aria-label="Mod type">
                        <button type="button" class="f3m-type-pill @(anyType ? string.Empty : "active")" aria-pressed="@(anyType ? "false" : "true")"
                                @onclick="() => SelectType(null)">
                            <i class="bi bi-grid-3x3-gap"></i>All types
                        </button>
                        @foreach (var type in types)
                        {
                            var active = selectedTags.Contains(type.Id);
                            <button type="button" class="f3m-type-pill @(active ? "active" : string.Empty)" aria-pressed="@(active ? "true" : "false")"
                                    title="@type.Description" @onclick="() => SelectType(active ? null : type.Id)">
                                <i class="bi @TypeIcon(type)"></i>@type.Name
                                <span class="f3m-type-pill-count">@type.TotalModCount</span>
                            </button>
                        }
                    </div>
                    @if (HasFilters)
                    {
                        <button type="button" class="f3m-filter-reset" @onclick="ClearFilters">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset filters
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</section>

<!-- Mod grid -->
<div class="container-fluid px-4 py-4">
    @if (loading)
    {
        @* The placeholders also tell how many cards fit on the screen (see OnAfterRenderAsync). *@
        <div class="mod-grid" @ref="placeholderGrid">
            @for (int i = 0; i < 12; i++)
            {
                <div class="mod-card-skeleton">
                    <div class="skeleton-img"></div>
                    <div class="skeleton-body">
                        <div class="skeleton-line w-75"></div>
                        <div class="skeleton-line w-50 mt-1"></div>
                        <div class="skeleton-line w-full mt-2"></div>
                        <div class="skeleton-line w-90"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (mods.Count == 0)
    {
        <div class="f3m-empty text-center py-5">
            <i class="bi bi-inbox display-3 opacity-50 d-block mb-3"></i>
            <h5 class="fw-bold mb-1">No mods found</h5>
            <p class="small">Try adjusting your filters.</p>
            <button class="btn btn-sm btn-outline-warning mt-2" @onclick="ClearFilters">Clear Filters</button>
        </div>
    }
    else
    {
        <div class="mod-grid">
            @foreach (var mod in mods)
            {
                <ModCard @key="mod.Id" Mod="mod" />
            }
        </div>

        @if (loadingMore)
        {
            <div class="text-center py-4">
                <span class="spinner-border spinner-border-sm text-warning me-2"></span>
                <span class="small">Loading more mods…</span>
            </div>
        }
        else if (mods.Count < totalCount)
        {
            @* Usually the list grows before this is reached; for keyboards, and when scrolling can't be watched. *@
            <div class="text-center py-4">
                <button class="btn btn-sm btn-outline-warning" @onclick="LoadMoreClicked">
                    Load more (@(totalCount - mods.Count) left)
                </button>
            </div>
        }
        else if (totalCount > batchSize)
        {
            <p class="text-center small py-4 mb-0">That's all @totalCount mods.</p>
        }
    }

    <div @ref="listEnd" aria-hidden="true"></div>
</div>
