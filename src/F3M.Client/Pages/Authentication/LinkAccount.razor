@page "/auth/link-account"
@inject NavigationManager Nav
@inject IF95LinkApi F95Link

<PageTitle>F3M – Link F95zone Account</PageTitle>

<div class="f3m-auth-page">
    <div class="f3m-auth-card">

        <div class="f3m-auth-logo">
            <span class="f3m-logo-badge" style="width:48px;height:48px;font-size:1.1rem;">F3M</span>
        </div>

        @if (dto.VerificationGuid == null)
        {
            <h2 class="fw-black text-center mb-1">Link F95zone Account</h2>
            <p class="text-center small mb-4" style="color:var(--f3m-muted)">
                New users are registered automatically. Returning users are logged in.
            </p>

            @if (error is not null)
            {
                <div class="alert alert-danger py-2 small mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
                </div>
            }

            <div class="mb-3">
                <label class="form-label fw-semibold small">F95zone Profile URL</label>
                <input class="form-control f3m-input"
                       placeholder="https://f95zone.to/members/YourUserName.12345/"
                       @bind="profileUrl"
                       @bind:event="oninput" />
                <div class="form-text" style="color:var(--f3m-muted)">
                    Find your URL by clicking your username → View profile.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small">Password</label>
                <input type="password"
                       class="form-control f3m-input"
                       placeholder="At least 8 characters"
                       @bind="password"
                       @bind:event="oninput" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold small">Confirm Password</label>
                <input type="password"
                       class="form-control f3m-input @(PasswordMismatch ? "is-invalid" : "")"
                       placeholder="Repeat your password"
                       @bind="confirmPassword"
                       @bind:event="oninput"
                       @onkeydown="OnConfirmKeyDown" />
                @if (PasswordMismatch)
                {
                    <div class="invalid-feedback">Passwords do not match.</div>
                }
            </div>

            <button class="btn btn-warning fw-bold w-100" @onclick="HandleStart" disabled="@loading">
                @if (loading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                <i class="bi bi-link-45deg me-1"></i>Start Verification
            </button>

            <p class="text-center small mt-4 mb-0">
                Admin account?
                <a href="/login" class="text-warning fw-semibold">Sign in with password</a>
            </p>
        }
        else
        {
            <h2 class="fw-black text-center mb-1">Verify Ownership</h2>
            <p class="text-center small mb-4" style="color:var(--f3m-muted)">
                Post the code below on your own F95zone profile wall.
            </p>

            @if (error is not null)
            {
                <div class="alert alert-danger py-2 small mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
                </div>
            }

            <div class="f3m-guid-box mb-3">
                <div class="small fw-semibold mb-2" style="color:var(--f3m-muted)">
                    <i class="bi bi-key-fill me-1 text-warning"></i>Your verification code
                </div>
                <div class="f3m-guid-code">@dto.VerificationGuid</div>
                <div class="small mt-2" style="color:var(--f3m-muted)">
                    <i class="bi bi-clock me-1"></i>Expires in 24 hours
                </div>
            </div>

            <ol class="small mb-4" style="color:var(--f3m-muted); padding-left:1.2rem; line-height:1.8">
                <li>
                    Go to your own profile:
                    <a href="@($"https://f95zone.to/members/{dto.F95Username}.{dto.F95UserId}/")" target="_blank" class="text-warning">
                        Your F95zone Profile
                    </a>
                </li>
                <li>Post a new message on your wall containing the code shown above.</li>
                <li>Click <strong>Check Verification</strong> below.</li>
            </ol>

            <button class="btn btn-warning fw-bold w-100 mb-2" @onclick="HandleCheck" disabled="@loading">
                @if (loading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                <i class="bi bi-arrow-repeat me-1"></i>Check Verification
            </button>

            <button class="btn btn-outline-secondary w-100 btn-sm" @onclick="ResetToStart">
                <i class="bi bi-arrow-left me-1"></i>Start over
            </button>
        }
    </div>
</div>
