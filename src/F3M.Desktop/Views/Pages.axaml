<DataTemplates xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:F3M.Desktop.ViewModels"
               xmlns:svc="using:F3M.Desktop.Services"
               xmlns:v="using:F3M.Desktop.Views">

  <!-- Library: the active profile's mods, with per-mod actions (plan 4.1, 6.6). -->
  <DataTemplate DataType="vm:LibraryViewModel">
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
        <TextBlock Classes="heading" Text="Library" />
        <TextBlock Classes="muted" Text="{Binding Summary}" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Changes here only reach the game folder when you press Deploy. Dependencies are added and removed for you." />
      </StackPanel>
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:LibraryRow">
              <Border Classes="card" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding State}" Classes="muted" />
                    <TextBlock Text="{Binding RequiredBy, StringFormat='Dependency of {0}'}"
                               Classes="muted" IsVisible="{Binding IsDependency}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Config" Command="{Binding ConfigCommand}" IsVisible="{Binding HasConfig}"
                            ToolTip.Tip="Edit this mod's settings file without opening it in a text editor." />
                    <Button Content="Pin version" Command="{Binding PinCommand}"
                            ToolTip.Tip="Keep this exact version, even when a newer one comes out. Only affects this profile on this computer." />
                    <Button Content="Unpin" Command="{Binding UnpinCommand}"
                            ToolTip.Tip="Follow the latest version again." />
                    <Button Content="Clear generated" Command="{Binding ClearGeneratedCommand}" IsVisible="{Binding IsDeployed}"
                            ToolTip.Tip="Delete files the mod created while the game ran, such as caches or logs. The mod stays installed. You see the list before anything is deleted." />
                    <Button Content="Remove" Command="{Binding RemoveCommand}"
                            ToolTip.Tip="Take this mod out of the profile. It leaves the game folder on the next Deploy; the download stays in the cache." />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </DataTemplate>

  <!-- Browse: the catalog grid, filter bar, and a detail panel (plan 3.3). -->
  <DataTemplate DataType="vm:BrowseViewModel">
    <Grid ColumnDefinitions="*,340" Margin="16" ColumnSpacing="16">
      <DockPanel Grid.Column="0">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,170,150,Auto" ColumnSpacing="8" Margin="0,0,0,12">
          <TextBox Grid.Column="0" Watermark="Search mods" Text="{Binding Search}" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
                    HorizontalAlignment="Stretch" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}"
                    HorizontalAlignment="Stretch" />
          <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCatalogCommand}"
                  ToolTip.Tip="Load the newest mod list from the server." />
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Classes="muted" v:Links.Markup="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ModCard">
                <Border Classes="card" Width="240" Margin="0,0,12,12" Padding="0" ClipToBounds="True">
                  <StackPanel>
                    <Border Height="130" Background="{DynamicResource F3M.Brush.Surface2}">
                      <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Margin="12" Spacing="4">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Author, StringFormat='by {0}'}" Classes="muted" />
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,0,0">
                        <Border Grid.Column="0" Classes="badge">
                          <TextBlock Text="{Binding Category}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding State}" Classes="muted" HorizontalAlignment="Right"
                                   ToolTip.Tip="Deployed: in your game folder. In profile: added, not deployed yet. Cached: downloaded, not in this profile." />
                      </Grid>
                      <Button Content="Details" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="8">
          <TextBlock Text="Mod details" Classes="heading" />
          <TextBlock Text="Choose Details on a mod to see it here." Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Detail.Name}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Detail.Author, StringFormat='by {0}'}" Classes="muted" />
          <TextBlock Text="{Binding Detail.Description}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Detail.Version, StringFormat='Version {0}'}" Classes="muted" />
          <TextBlock Text="{Binding Detail.Published, StringFormat='Published {0}'}" Classes="muted" />
          <TextBlock Text="{Binding Detail.Size, StringFormat='Download size {0}'}" Classes="muted" />
          <TextBlock Text="{Binding Detail.Dependencies, StringFormat='Requires: {0}'}" Classes="muted" TextWrapping="Wrap" />
          <Border Classes="badge" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Detail.Category}" />
          </Border>
          <TextBlock Text="{Binding Detail.Unsupported}" Foreground="{DynamicResource F3M.Brush.Error}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Classes="primary" Content="Add to profile" Command="{Binding AddSelectedCommand}"
                    ToolTip.Tip="Add this mod and what it requires to the active profile. Press Deploy to install it." />
            <Button Content="Download" Command="{Binding DownloadSelectedCommand}"
                    ToolTip.Tip="Only download it into the cache, for later or offline use. Nothing is installed." />
          </StackPanel>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Add to profile is all you need: missing files are downloaded during Deploy." />
        </StackPanel>
      </Border>
    </Grid>
  </DataTemplate>

  <!-- Profiles: list on the left, the selected profile on the right (plan 6.9, 10.2). -->
  <DataTemplate DataType="vm:ProfilesViewModel">
    <Grid ColumnDefinitions="260,*" Margin="16" ColumnSpacing="16">
      <DockPanel Grid.Column="0">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
          <TextBlock Classes="heading" Text="Profiles" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="A profile is a list of mods. Keep one per playstyle and switch between them; only one is in the game folder at a time." />
          <Button Content="New profile" Command="{Binding NewProfileCommand}" HorizontalAlignment="Stretch"
                  ToolTip.Tip="Start an empty profile. Switch to it, then add mods from Browse." />
        </StackPanel>
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="10">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Name" Classes="muted" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding EditName}" />
                <Button Grid.Column="1" Content="Rename" Command="{Binding RenameCommand}" />
              </Grid>
              <TextBlock Text="Mods in this profile" Classes="muted" Margin="0,8,0,0" />
              <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel Margin="0,10,0,0">
                <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Margin="0,0,8,8"
                        ToolTip.Tip="Copy this profile, including its pinned versions, to try changes without losing it." />
                <Button Content="Capture current" Command="{Binding CaptureCurrentCommand}" Margin="0,0,8,8"
                        ToolTip.Tip="Save the mods that are in the game folder right now as a new profile. Pins are not copied." />
                <Button Classes="primary" Content="Switch to this profile" Command="{Binding SwitchCommand}" Margin="0,0,8,8"
                        ToolTip.Tip="Make this the active profile. You see a summary first, then the game folder is changed to match it." />
                <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,8,8"
                        ToolTip.Tip="Delete this profile. Downloaded mods stay in the cache. The deployed profile can't be deleted." />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Share" Classes="heading" />
              <TextBlock Text="A web link that lists this profile's mods. Others can open it in a browser and press Use this setup to import it into their F3M Desktop. Pins are left out." Classes="muted" TextWrapping="Wrap" />
              <Button Content="Create link" Command="{Binding ShareCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding ShareLink}" v:Links.Target="{Binding ShareLink}" TextWrapping="Wrap" />
              <Button Content="Copy link" Command="{Binding CopyLinkCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <TextBlock v:Links.Markup="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DataTemplate>

  <!-- Downloads: operation list with progress and cancel (plan 4.2). -->
  <DataTemplate DataType="vm:DownloadsViewModel">
    <DockPanel Margin="16">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,12">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Classes="heading" Text="Downloads" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Downloads are kept in a local cache, so switching profiles or reinstalling doesn't download them again." />
          <TextBlock Classes="muted" Text="{Binding CacheInfo}" />
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh size" Command="{Binding RefreshCacheInfoCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Recount how much space unused downloads take." />
        <Button Grid.Column="2" Content="Clear finished" Command="{Binding ClearFinishedCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Remove finished entries from this list. Downloaded files are kept." />
      </Grid>
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="svc:OperationItem">
              <Border Classes="card" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status}" Classes="muted" />
                  <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" />
                  <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Detail}" Classes="muted" />
                    <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}"
                            ToolTip.Tip="Stop this operation. A cancelled deploy puts the game folder back as it was." />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </DataTemplate>

  <!-- Settings: server, game folder, launch, and maintenance (plan 2.2, 6.11, 9.4). -->
  <DataTemplate DataType="vm:SettingsViewModel">
    <DockPanel>
      <!-- Save bar: always visible, so it is clear that Save covers every field on the page. -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource F3M.Brush.Surface}"
              BorderBrush="{DynamicResource F3M.Brush.Border}" BorderThickness="0,1,0,0" Padding="16,10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" IsVisible="{Binding HasChanges}"
                       Foreground="{DynamicResource F3M.Brush.Accent}" />
            <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" IsVisible="{Binding !HasChanges}" Classes="muted" />
            <TextBlock Classes="muted" v:Links.Markup="{Binding Status}" TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Button Grid.Column="1" Content="Discard" Command="{Binding DiscardCommand}" VerticalAlignment="Center"
                  ToolTip.Tip="Put every field back to the saved settings." />
          <Button Grid.Column="2" Classes="primary" Content="Save settings" Command="{Binding SaveCommand}" VerticalAlignment="Center"
                  ToolTip.Tip="Saves every field on this page. A new game folder shows that folder's profiles (you confirm first), a new server reloads the mod list, and start at login is turned on or off." />
        </Grid>
      </Border>

    <ScrollViewer Margin="16">
      <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Classes="heading" Text="Settings" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Fields are kept when you press Save settings at the bottom. Buttons inside the cards, such as Clear unused cache or Factory reset, act right away." />

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Server address" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Text="The F3M website the mod list comes from. Leave it as it is unless you run your own server." TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding ServerUrl}" Watermark="https://" />
              <Button Grid.Column="1" Content="Open" Command="{Binding OpenServerCommand}"
                      ToolTip.Tip="Open this address in your browser." />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Game" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Text="Game folder: where the game is installed. Mods are deployed into it." TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding GameFolder}" Watermark="Game folder" />
              <Button Grid.Column="1" Content="Open" Command="{Binding OpenGameFolderCommand}"
                      ToolTip.Tip="Open the game folder in your file manager." />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Auto-detect" Classes="primary" Command="{Binding AutoDetectGameCommand}"
                      ToolTip.Tip="Looks for the game: a running game, your Steam libraries, then the usual install folders. Fills in the folder, the executable and, for Steam, the app ID. Nothing is kept until you press Save settings." />
              <Button Content="Choose game folder" Command="{Binding PickGameFolderCommand}" />
            </StackPanel>
            <TextBlock Classes="muted" v:Links.Markup="{Binding DetectStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding DetectStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl ItemsSource="{Binding FoundInstalls}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:GameInstallRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Folder}" v:Links.Target="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" Text="{Binding Source}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Use" Command="{Binding UseCommand}" Margin="8,0,0,0"
                            ToolTip.Tip="Fills in this folder and its executable. Press Save settings to keep it." />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted" Text="Executable: the file Play starts, for example Game.exe." TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBox Text="{Binding GameExecutable}" Watermark="Executable, relative to the game folder" />
            <Button Content="Choose executable" Command="{Binding PickExecutableCommand}" HorizontalAlignment="Left" />
            <TextBlock Classes="muted" Text="Steam app ID (optional): when set, Play starts the game through Steam instead. It's the number in the game's Steam store address." TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBox Text="{Binding SteamAppId}" Watermark="Steam app ID" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Updates and cache" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Text="How often to look for newer versions of your mods (1 to 168 hours). Updates are never installed without asking." TextWrapping="Wrap" />
            <TextBox Text="{Binding UpdateCheckHours}" Watermark="Check for updates every (hours)" />
            <TextBlock Classes="muted" Text="How much disk space downloaded mods may use (GB). Above it, the downloads used longest ago are removed; deployed and pinned ones are kept." TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBox Text="{Binding CacheLimitGb}" Watermark="Cache size limit (GB)" />
            <CheckBox Content="Start F3M Desktop when I sign in" IsChecked="{Binding LaunchAtLogin}"
                      ToolTip.Tip="Starts minimised to the tray, so update checks and website links work right away." />
            <Button Content="Clear unused cache" Command="{Binding ClearUnusedCacheCommand}" HorizontalAlignment="Left"
                    ToolTip.Tip="Right away: delete downloads that are neither deployed nor pinned in any profile. You see how much is freed before anything is deleted." />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Links and diagnostics" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Text="Lets buttons on the website, such as Use this setup, open this app. Do it once, and again if you move the app." TextWrapping="Wrap" />
            <Button Content="Register f3m:// links" Command="{Binding RegisterLinksCommand}" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="muted" Text="Data folder:" />
              <TextBlock FontSize="12" Text="{Binding DataFolder}" v:Links.Target="{Binding DataFolder}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Classes="muted" Text="Something not working? Copy diagnostics and paste them into your bug report." TextWrapping="Wrap" />
            <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Factory reset" FontWeight="SemiBold" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Removes everything this app created: settings, profiles, logs and link registrations, and downloaded mods if you choose. The game folder and the mods deployed in it are not touched. You see every folder and its size before anything is deleted." />
            <Button Classes="danger" Content="Factory reset…" Command="{Binding FactoryResetCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
    </DockPanel>
  </DataTemplate>

</DataTemplates>
