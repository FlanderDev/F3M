<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="F3M.Desktop.Views.ConfirmWindow"
        Width="540" Height="380"
        MinWidth="420" MinHeight="240"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto" Margin="20">
    <ScrollViewer Grid.Row="0">
      <TextBlock x:Name="BodyText" TextWrapping="Wrap" />
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="CancelButton" Content="Cancel" />
      <Button x:Name="OkButton" Classes="primary" Content="OK" />
    </StackPanel>
  </Grid>
</Window>
